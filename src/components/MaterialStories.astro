---
import cotton from '@/assets/images/material-organic-cotton.webp'
import polyester from '@/assets/images/material-recycled-polyester.webp'
import ImageFrame from './ImageFrame.astro'
import SectionAside from './SectionAside.astro'
import SectionIndex from './SectionIndex.astro'
import SectionRule from './SectionRule.astro'

const stories = [
  {
    id: '2003:176',
    p: 'I2003:176',
    tag: 'Organic cotton',
    name: 'オーガニックコットン',
    body: '毎日、肌にふれるものだから。LOOP THREADが選ぶ素材のひとつ、オーガニックコットン。ベーシックウェアを、素材から見つめます。',
    src: cotton,
    alt: 'ゆるやかに波打つ白い生地の接写。細かな織り目と柔らかなひだが見える。',
  },
  {
    id: '2003:184',
    p: 'I2003:184',
    tag: 'Recycled polyester',
    name: '再生ポリエステル',
    body: '素材の選択肢を、これからの視点で。もうひとつの素材は、再生ポリエステル。日常の服に使う素材を、丁寧に選んでいます。',
    src: polyester,
    alt: '折り返されたチャコールグレーの生地の接写。細かな編み目が見える。',
  },
]
---

<section class="flex flex-col gap-12 px-page pb-section" data-node-id="2001:108" data-name="material-stories">
  <SectionRule nodeId="2001:109" />
  <div class="flex flex-col gap-8 lg:flex-row lg:gap-16" data-node-id="2001:110" data-name="material-editorial">
    <SectionAside class="gap-8 lg:self-start text-brand-accent" nodeId="2001:111" name="editorial-heading">
      <SectionIndex
        index="03"
        label="Two materials"
        nodeId="2001:112"
        indexNodeId="2001:113"
        labelNodeId="2001:114"
      />
      <h2 class="type-section-heading" data-node-id="2001:115">
        素材を選ぶ。<br />毎日を考える。
      </h2>
      <p class="type-body" data-node-id="2001:116">
        使うのは、オーガニックコットンと再生ポリエステルのみ。飾りすぎず、素材と向き合う服づくりを。
      </p>
    </SectionAside>
    <div class="flex flex-1 flex-col gap-8" data-node-id="2001:117" data-name="texture-stories">
      {
        stories.map((s) => (
          <article class="flex flex-col gap-8" data-node-id={s.id} data-name="material-story">
            <div class="flex flex-col gap-4 md:flex-row md:gap-8" data-node-id={`${s.p};2001:119`} data-name="texture-and-copy">
              <ImageFrame
                src={s.src}
                alt={s.alt}
                frameClass="h-56 shrink-0 md:h-66 md:w-96"
                widths={[400, 768]}
                sizes="(min-width: 1440px) 384px, 40vw"
                nodeId={`${s.p};2001:120`}
                name="material-texture"
              />
              <div
                class="flex flex-1 flex-col gap-6 pt-2 text-brand-accent"
                data-node-id={`${s.p};2001:121`}
                data-name="material-information"
              >
                <p
                  class="type-eyebrow"
                  data-node-id={`${s.p};2001:122`}
                >
                  {s.tag}
                </p>
                <h3
                  class="text-xl font-heading-h3 leading-heading-h3"
                  data-node-id={`${s.p};2001:123`}
                >
                  {s.name}
                </h3>
                <p
                  class="type-body"
                  data-node-id={`${s.p};2001:124`}
                >
                  {s.body}
                </p>
              </div>
            </div>
            <SectionRule nodeId={`${s.p};2001:125`} />
          </article>
        ))
      }
      <p class="type-caption text-brand-accent" data-node-id="2001:134">
        素材写真はイメージです
      </p>
    </div>
  </div>
</section>
