---
import Arrow from './Arrow.astro'

interface Props {
  href?: string
  label: string
  nodeId?: string
  labelNodeId?: string
  arrowNodeId?: string
}

const { href = '#', label, nodeId, labelNodeId, arrowNodeId } = Astro.props
---

<a
  href={href}
  class="inline-flex items-center gap-4 whitespace-nowrap text-brand-accent hover:text-brand-accent-hover"
  data-node-id={nodeId}
  data-name="text-link"
>
  <span class="text-base font-body-link leading-body-link" data-node-id={labelNodeId}>{label}</span>
  <Arrow nodeId={arrowNodeId} />
</a>
