---
import remakePhotograph from '@/assets/images/remake-concept-photograph.webp'
import ImageFrame from './ImageFrame.astro'
import PhotoCaption from './PhotoCaption.astro'
import SectionAside from './SectionAside.astro'
import SectionIndex from './SectionIndex.astro'
import TextLink from './TextLink.astro'
---

<section class="flex flex-col gap-8 lg:flex-row lg:gap-16 px-page py-section" data-node-id="2001:172" data-name="remake-line">
  <SectionAside class="gap-8 lg:self-start" nodeId="2001:173" name="remake-introduction">
    <div class="flex flex-col gap-8 text-brand-accent" data-node-id="2001:174" data-name="editorial-heading">
      <SectionIndex
        index="05"
        label="Remake line"
        nodeId="2001:175"
        indexNodeId="2001:176"
        labelNodeId="2001:177"
      />
      <h2 class="type-section-heading" data-node-id="2001:178">
        廃棄予定の生地を、<br />新しい一着へ。
      </h2>
      <p class="type-body" data-node-id="2001:179">
        まだ服になれる生地に、もう一度、出番を。廃棄予定の生地を使ったリメイクラインを、不定期で届けます。
      </p>
    </div>
    <div class="self-start bg-brand-accent-2 px-4 py-2" data-node-id="2001:180" data-name="release-cadence">
      <p
        class="type-caption text-brand-accent whitespace-nowrap"
        data-node-id="2001:181"
      >
        不定期リリース
      </p>
    </div>
    <TextLink
      label="リメイクラインを知る"
      nodeId="2001:182"
      labelNodeId="2001:183"
      arrowNodeId="2001:184"
    />
  </SectionAside>
  <figure class="flex flex-1 flex-col gap-4" data-node-id="2001:185" data-name="remake-editorial">
    <ImageFrame
      src={remakePhotograph}
      alt="作業台に広げた、深緑とチャコールグレーの布をつなぎ合わせた長袖スウェット。周囲に四角い布片が並ぶ。"
      frameClass="h-64 md:h-96 lg:h-112"
      widths={[600, 896, 1376]}
      sizes="(min-width: 1440px) 896px, 60vw"
      nodeId="2001:186"
      name="remake-concept-photograph"
    />
    <PhotoCaption
      latin="A new chapter for fabric."
      nodeId="2001:187"
      name="remake-caption"
      latinNodeId="2001:188"
      noteNodeId="2001:189"
    />
  </figure>
</section>
