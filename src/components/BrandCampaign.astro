---
import campaignPhotograph from '@/assets/images/campaign-photograph.webp'
import ActionButton from './ActionButton.astro'
import ImageFrame from './ImageFrame.astro'
import PhotoCaption from './PhotoCaption.astro'
import TextLink from './TextLink.astro'
---

<section class="flex flex-col gap-8 px-16 pt-12 pb-24" data-node-id="2001:20" data-name="brand-campaign">
  <div
    class="flex flex-col gap-1 type-caption text-brand-accent sm:flex-row sm:items-center sm:justify-between"
    data-node-id="2001:21"
    data-name="campaign-introduction"
  >
    <p class="font-space-grotesk uppercase" data-node-id="2001:22">Essentials, with a reason.</p>
    <p data-node-id="2001:23">日本発、サステナブルなベーシックウェア。</p>
  </div>
  <h1
    class="break-keep text-4xl md:text-5xl lg:text-6xl font-heading-hero leading-heading-hero text-brand-accent"
    data-node-id="2001:24"
  >
    選ぶ理由が、<wbr />見える服。
  </h1>
  <div class="flex flex-col items-start gap-8 lg:flex-row lg:items-end lg:gap-16" data-node-id="2001:25" data-name="campaign-lead-and-actions">
    <div class="flex w-full flex-col gap-4 lg:w-156" data-node-id="2001:26" data-name="brand-promise">
      <p class="type-body text-brand-accent" data-node-id="2001:27">
        日々をともにする一着を、素材から、つくる背景から。長く着ることを大切にするあなたへ、LOOP THREADのベーシックを。
      </p>
      <TextLink
        label="一着の背景をたどる"
        nodeId="2001:28"
        labelNodeId="2001:29"
        arrowNodeId="2001:30"
      />
    </div>
    <div class="flex w-full justify-start lg:flex-1 lg:justify-end" data-node-id="2001:31" data-name="collection-action">
      <ActionButton
        label="コレクションを見る"
        nodeId="2003:75"
        labelNodeId="2001:33"
        arrowNodeId="2001:34"
      />
    </div>
  </div>
  <figure class="contents">
    <ImageFrame
      src={campaignPhotograph}
      alt="日差しの入るコンクリートの室内で、白いTシャツと濃色のパンツ姿で座るモデルと、深緑のスウェットとチャコールグレーのパンツ姿で立つモデル。"
      frameClass="h-64 md:h-96 lg:h-136"
      widths={[800, 1312, 1584]}
      sizes="(min-width: 1440px) 1312px, 100vw"
      loading="eager"
      nodeId="2001:35"
      name="campaign-photograph"
    />
    <PhotoCaption
      latin="The everyday, considered."
      nodeId="2001:36"
      name="campaign-caption"
      latinNodeId="2001:37"
      noteNodeId="2001:38"
    />
  </figure>
</section>
