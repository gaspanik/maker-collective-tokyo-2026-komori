---
import SectionIndex from './SectionIndex.astro'
import SectionRule from './SectionRule.astro'
import TextLink from './TextLink.astro'
---

<section class="flex flex-col gap-12 px-16 pb-24" data-node-id="2001:190" data-name="used-clothing-collection-program">
  <SectionRule nodeId="2001:191" />
  <div class="flex gap-16 text-brand-accent" data-node-id="2001:192" data-name="program-editorial">
    <div class="flex w-88 shrink-0 flex-col gap-8" data-node-id="2001:193" data-name="editorial-heading">
      <SectionIndex
        index="06"
        label="Keep the loop going"
        nodeId="2001:194"
        indexNodeId="2001:195"
        labelNodeId="2001:196"
      />
      <h2 class="text-3xl font-heading-h1 leading-heading-h1" data-node-id="2001:197">
        着た、その先も。
      </h2>
    </div>
    <div class="flex flex-1 flex-col gap-8" data-node-id="2001:198" data-name="membership-program">
      <h3 class="text-2xl font-heading-h2 leading-heading-h2" data-node-id="2001:199">
        服を戻すことが、次の選択につながる。
      </h3>
      <p class="text-base font-body-regular leading-body-regular text-justify" data-node-id="2001:200">
        LOOP THREADの会員登録者は、古着回収プログラムへの参加でポイント還元を受けられます。大切に着た服の、その先を考えるきっかけに。
      </p>
      <div class="flex items-center gap-12" data-node-id="2001:201" data-name="program-next-steps">
        <TextLink
          label="会員登録して、回収プログラムへ"
          nodeId="2001:202"
          labelNodeId="2001:203"
          arrowNodeId="2001:204"
        />
        <TextLink
          label="回収プログラムについて"
          nodeId="2001:205"
          labelNodeId="2001:206"
          arrowNodeId="2001:207"
        />
      </div>
    </div>
  </div>
</section>
