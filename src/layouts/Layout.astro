---
import "@/styles/global.css";

interface Props {
  title?: string;
}

const { title = "Astro 7 + Tailwind CSS 4 Starter" } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500&family=Space+Grotesk:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
